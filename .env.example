# ============================================================
# CECH web app (Next.js) — copy to .env.local for development
# Never commit real values.
# ============================================================

# --- Groq (the only AI provider) -----------------------------
GROQ_API_KEY=
# Must support JSON output; strict json_schema is used when supported.
GROQ_MODEL=openai/gpt-oss-120b

# --- Supabase ------------------------------------------------
# Leave empty for local development: CECH then uses .data/cech-db.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Kane worker ---------------------------------------------
# Base URL of the worker service (see worker/README.md)
KANE_WORKER_URL=http://localhost:8787
# Shared secret (min 16 chars). Generate: openssl rand -hex 24
KANE_WORKER_SECRET=

# --- App -----------------------------------------------------
# Public URL of this app (used in docs; the worker needs the same value)
CECH_APP_URL=http://localhost:3000

# DEVELOPMENT ONLY: exact host:port pairs allowed past SSRF protection,
# so the built-in demo site can be inspected on localhost. Leave EMPTY in production.
SSRF_ALLOWLIST=localhost:3000
