# ============================================================
# CECH Kane worker — copy to worker/.env
# ============================================================
PORT=8787
# Must equal KANE_WORKER_SECRET in the app.
KANE_WORKER_SECRET=
# Public URL of the CECH app; results are POSTed to $CECH_APP_URL/api/worker/callback.
# If unset, the app pulls results from GET /jobs/:id instead.
CECH_APP_URL=http://localhost:3000

# TestMu AI (LambdaTest) credentials for Kane CLI. Used once at startup for
# `kane-cli login`. Get the access key from TestMu AI → Settings → Keys.
LT_USERNAME=
LT_ACCESS_KEY=

# Execution limits
KANE_TEST_TIMEOUT_SEC=180
KANE_JOB_TIMEOUT_SEC=1500
KANE_MAX_CONCURRENCY=2
KANE_MAX_STEPS=30
KANE_MAX_QUEUED_JOBS=20
# Set to false to watch Chrome on a machine with a display (great for demos)
KANE_HEADLESS=true
# KANE_CLI_BIN=kane-cli
# KANE_CLI_CHROME_PATH=/usr/bin/google-chrome

# DEVELOPMENT ONLY — must match the app. Empty in production.
SSRF_ALLOWLIST=localhost:3000
